# ===========================================================================
# OpenSciGraph · 环境变量示例
# ---------------------------------------------------------------------------
# 用法：复制为 .env 并填入真实值。`.env` 已被 .gitignore 排除，不会入库。
# ⚠️ 严禁把真实令牌写进本文件、或任何会被提交的文件里。
#    本文件（.env.example）是唯一允许入库的模板，里面只能有占位符。
# ===========================================================================

# HuggingFace 访问令牌（上传数据集必需，需要 write 权限）。
# 申请地址：https://huggingface.co/settings/tokens
# 设置方式（PowerShell，仅当前会话有效、不落盘）：
#     $env:HF_TOKEN = "hf_你的令牌"
# 注意：下面用尖括号占位符而非 "hf_xxxx…"，避免被密钥扫描器误判为真实令牌。
HF_TOKEN=<你的-HuggingFace-令牌>

# HuggingFace 端点。
# 官方站点 huggingface.co 在中国大陆通常不可达（本机实测 502）；
# hf-mirror.com 实测可达且透传写操作（create_repo / upload_file 均可用）。
# 不设时脚本默认走镜像。
# HF_ENDPOINT=https://hf-mirror.com
